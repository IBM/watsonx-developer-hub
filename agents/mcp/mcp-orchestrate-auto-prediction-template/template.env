# Copy to .env and fill in real values.
# DO NOT commit the .env file.

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_SPACE_ID=
WATSONX_DEPLOYMENT_ID=

# Optional: LLM to use in the generated agent.yaml.
# Defaults to "groq/openai/gpt-oss-120b" if not set.
# Override this if that model is not available on your Orchestrate instance.
# LLM_NAME=groq/openai/gpt-oss-120b

# ── Fallback schema (required only if the deployment asset lacks metadata) ────
#
# Some deployments (e.g. models whose schema was stripped during export,
# functions, or AI services) do not carry input_fields or label_column in
# their metadata.  When that happens, generate_template.py and the MCP server
# will raise a descriptive error and ask you to set the two variables below.
#
# DEPLOYMENT_INPUT_FIELDS – JSON array of input field descriptors.
#   Each object must have at least a "name" key; "type" is optional (defaults
#   to "string").  Supported types: string, integer, number, boolean.
#   Example (single line, quotes around the whole value):
#     DEPLOYMENT_INPUT_FIELDS='[{"name":"age","type":"integer"},{"name":"city","type":"string"},{"name":"income","type":"number"}]'
#
# DEPLOYMENT_LABEL_COLUMN – Name of the prediction target column.
#   Example:
#     DEPLOYMENT_LABEL_COLUMN=risk
#
# DEPLOYMENT_INPUT_FIELDS=
# DEPLOYMENT_LABEL_COLUMN=
