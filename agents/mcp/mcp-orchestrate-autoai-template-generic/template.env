# Copy to .env and fill in real values.
# DO NOT commit the .env file.

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_SPACE_ID=
WATSONX_AUTOAI_DEPLOYMENT_ID=

# Optional: LLM to use in the generated agent.yaml.
# Defaults to "groq/openai/gpt-oss-120b" if not set.
# Override this if that model is not available on your Orchestrate instance.
# LLM_NAME=groq/openai/gpt-oss-120b

# ── Fallback schema (required only if the model asset lacks metadata) ─────────
#
# Some deployments (e.g. models created outside of AutoAI, or whose schema was
# stripped during export) do not carry input_fields or label_column in their
# metadata.  When that happens, generate_template.py and the MCP server will
# raise a descriptive error and ask you to set the two variables below.
#
# AUTOAI_INPUT_FIELDS – JSON array of input field descriptors.
#   Each object must have at least a "name" key; "type" is optional (defaults
#   to "string").  Supported types: string, integer, number, boolean.
#   Example (single line, quotes around the whole value):
#     AUTOAI_INPUT_FIELDS='[{"name":"age","type":"integer"},{"name":"city","type":"string"},{"name":"income","type":"number"}]'
#
# AUTOAI_LABEL_COLUMN – Name of the prediction target column.
#   Example:
#     AUTOAI_LABEL_COLUMN=risk
#
# AUTOAI_INPUT_FIELDS=
# AUTOAI_LABEL_COLUMN=
